#ifndef DALI_CORE_VERSION_H_
#define DALI_CORE_VERSION_H_

/**
 * @file version.h
 *
 * DALI version information, generated by CMake from the VERSION file.
 *
 * This header is not included by any other DALI header, so that a version bump
 * does not trigger a rebuild of the whole project. Include it explicitly where needed.
 */

/** Major version number, e.g. 1 for 1.2.3 */
#define DALI_VERSION_MAJOR @DALI_VERSION_MAJOR@
/** Minor version number, e.g. 2 for 1.2.3 */
#define DALI_VERSION_MINOR @DALI_VERSION_MINOR@
/** Patch version number, e.g. 3 for 1.2.3 */
#define DALI_VERSION_PATCH @DALI_VERSION_PATCH@
/** Version suffix, e.g. "dev" for 1.2.3dev, empty string for a release build */
#define DALI_VERSION_SUFFIX "@DALI_VERSION_SUFFIX@"
/** Full version string as found in the VERSION file, e.g. "1.2.3dev" */
#define DALI_VERSION_STRING "@DALI_VERSION@"

/**
 * Encodes a version triple as a single integer, comparable with DALI_VERSION.
 * DALI_MAKE_VERSION(1, 2, 3) == 10203
 */
#define DALI_MAKE_VERSION(major, minor, patch) ((major) * 10000 + (minor) * 100 + (patch))

/** DALI version encoded as a single integer, see DALI_MAKE_VERSION */
#define DALI_VERSION DALI_MAKE_VERSION(DALI_VERSION_MAJOR, DALI_VERSION_MINOR, DALI_VERSION_PATCH)

#endif  // DALI_CORE_VERSION_H_
